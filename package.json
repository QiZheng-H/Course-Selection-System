{
  "name": "course-selection-system",
  "private": true,
  "version": "1.0.0",
  "description": "大学选课系统：志愿提交、统一分配、毕业保障、候补调度与正式选退换课",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "setup": "npm install && npm run db:reset",
    "install:all": "npm install",
    "db:init": "npm run db:init -w server",
    "db:seed": "npm run db:seed -w server",
    "db:reset": "npm run db:reset -w server",
    "dev": "npm run dev:web",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "watch:web": "node scripts/watch.mjs \"npm run build:watch -w web\"",
    "watch:build": "node scripts/watch.mjs \"npm run build:watch -w server\" \"npm run build:watch -w web\"",
    "watch:serve": "node scripts/watch.mjs \"npm run build:watch -w server\" \"npm run build:watch -w web\" \"npm run start:watch -w server\"",
    "test": "npm run test -w server",
    "demo": "npm run demo -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.4",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "multer": "^2.4.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  }
}
