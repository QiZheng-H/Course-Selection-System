{
  "name": "@css/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "选课系统后端：Express + TypeScript + SQLite(better-sqlite3) 模块化单体",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "copy:assets": "node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "start:watch": "node --watch dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "tsx src/db/cli.ts init",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:reset": "tsx src/db/cli.ts reset",
    "db:status": "tsx src/db/cli.ts status",
    "demo": "tsx scripts/demo.ts",
    "import:class": "tsx scripts/import-class-members.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
