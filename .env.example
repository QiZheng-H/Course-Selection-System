# ---------- 后端（server） ----------
# HTTP 监听地址与端口
HOST=127.0.0.1
PORT=3001

# SQLite 数据库文件位置（相对路径以 server/ 为基准；默认 server/data/course-selection.db）
# DB_PATH=./data/course-selection.db

# 会话有效期（小时）
SESSION_TTL_HOURS=12

# 规划 / 分配任务的单次计算上限（毫秒）。超时不会发布部分结果。
TASK_TIMEOUT_MS=60000

# 专业课预分配的默认调整余量（管理员也可以在导入数据里逐条设置）
PREALLOCATION_MARGIN=2

# ---------- 选课助手的在线模型（可选，默认关闭） ----------
# 不配置时系统使用离线规则引擎：不需要联网、不上传任何资料。
# 启用步骤：① 在管理端把配置项 agent_online_enabled 设为 true；② 填写下面三项。
# LLM_PROVIDER=openai-compatible
# LLM_ENDPOINT=https://api.example.com/v1/chat/completions
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=your-model-name

# 测试环境标记（由 npm test 自动设置，一般不用手动配置）
# NODE_ENV=test
